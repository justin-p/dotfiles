[user]
    name = Justin-p
    email = justin-p@users.noreply.github.com
    signingkey = ~/.ssh/justin_p_github_signing_key.pub

[includeIf "gitdir:~/git/gitlab-work/"]
    path = .gitconfig-work

[init]
    defaultBranch = main

[core]
    autocrlf = false
    branch = auto
    diff = auto
    interactive = auto
    status = auto
    ui = true
    editor = code -n -w # VS Code
    excludesfile = ~/.gitignore_global
    longpaths = true

[color]
    ui = true

[include]
    path = .delta-themes.gitconfig

[pager]
    diff = ~/.local/bin/git-pager-delta
    show = ~/.local/bin/git-pager-delta
    log = less -FRX

[delta]
    features = bearded-theme-feat-gold-d-raynh
    true-color = always
    navigate = true
    side-by-side = true
    hyperlinks = true
    conflictStyle = zdiff3

[interactive]
    diffFilter = ~/.local/bin/git-pager-delta --color-only

[push]
    default = current
    autoSetupRemote = true

[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[filter "lfs"]
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
