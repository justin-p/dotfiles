#!/usr/bin/env bash
set -euo pipefail

resolve_mount_point() {
  local env_file="${HOME}/.config/smb/homesrv.env"
  local mount_point="${HOME}/homesrv"

  if [[ -f "${env_file}" ]]; then
    # shellcheck source=/dev/null
    source "${env_file}"
    mount_point="${MOUNT_POINT:-${HOME}/homesrv}"
    mount_point="${mount_point//\$\{HOME\}/${HOME}}"
    mount_point="${mount_point/#\~/${HOME}}"
  fi

  printf '%s' "${mount_point}"
}

MOUNT_POINT="$(resolve_mount_point)"
UNIT="$(systemd-escape --path "${MOUNT_POINT}")"

echo "Removing SMB automount for ${MOUNT_POINT}..."

sudo systemctl stop "${UNIT}.automount" 2>/dev/null || true
if mountpoint -q "${MOUNT_POINT}" 2>/dev/null; then
  sudo umount "${MOUNT_POINT}" 2>/dev/null || sudo umount -l "${MOUNT_POINT}" 2>/dev/null || true
fi

if grep -qF "${MOUNT_POINT}" /etc/fstab 2>/dev/null; then
  sudo sed -i "\|${MOUNT_POINT}|d" /etc/fstab
  echo "Removed fstab entry."
fi

sudo systemctl daemon-reload
sudo systemctl reset-failed "${UNIT}.automount" "${UNIT}.mount" 2>/dev/null || true

rm -f "${HOME}/.config/smb/homesrv.env"
rm -f "${HOME}/.config/smb/credentials"

echo "Removed local secrets under ~/.config/smb/ (kept *.example from stow)."
echo "Done. Re-setup: cp ~/.config/smb/homesrv.env.example ~/.config/smb/homesrv.env && setup-homesrv-mount"
