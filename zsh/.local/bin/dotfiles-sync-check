#!/usr/bin/env bash
# Warn when ~/.dotfiles is out of sync (git or stow). Runs from ~/.zshrc (once per day).
# Force: DOTFILES_SYNC_CHECK_FORCE=1
# Skip remote fetch: DOTFILES_SYNC_CHECK_FETCH=0

[[ -z ${CURSOR_AGENT:-}${CURSOR_TRACE:-} ]] || exit 0
command -v git &>/dev/null || exit 0
command -v stow &>/dev/null || exit 0

_lib=${BASH_SOURCE[0]%/*}/dotfiles-lib.sh
[[ -f $_lib ]] || _lib=${HOME}/.dotfiles/zsh/.local/bin/dotfiles-lib.sh
# shellcheck source=/dev/null
source "$_lib"

stamp=${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-sync.stamp
mkdir -p "${stamp%/*}"
today=$(date +%Y%m%d)
if [[ ${DOTFILES_SYNC_CHECK_FORCE:-} != 1 ]] && [[ -f $stamp ]] && [[ $(<"$stamp") == "$today" ]]; then
  exit 0
fi

fetch=1
[[ ${DOTFILES_SYNC_CHECK_FETCH:-1} == 0 ]] && fetch=0
dotfiles_sync_detect "$fetch" || exit 0

echo "$today" >"$stamp"
(( ${#DOTFILES_SYNC_ISSUES[@]} )) || exit 0

summary=$(printf '%s; ' "${DOTFILES_SYNC_ISSUES[@]}")
summary=${summary%; }

dotfiles_msg "repository out of sync" "$summary"
dotfiles_msg fix "dotfiles-sync-fix (-n to preview)"
