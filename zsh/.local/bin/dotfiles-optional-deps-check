#!/usr/bin/env bash
# Warn when optional tools for dotfiles integrations are missing.
# Runs from 130-optional-deps.zsh (once per day). Force: DOTFILES_OPTIONAL_DEPS_FORCE=1

[[ -z ${CURSOR_AGENT:-}${CURSOR_TRACE:-} ]] || exit 0
command -v apt-get &>/dev/null || exit 0

_lib=${BASH_SOURCE[0]%/*}/dotfiles-lib.sh
[[ -f $_lib ]] || _lib=${HOME}/.dotfiles/zsh/.local/bin/dotfiles-lib.sh
# shellcheck source=/dev/null
source "$_lib"

stamp=${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-optional-deps.stamp
mkdir -p "${stamp%/*}"
today=$(date +%Y%m%d)
if [[ ${DOTFILES_OPTIONAL_DEPS_FORCE:-} != 1 ]] && [[ -f $stamp ]] && [[ $(<"$stamp") == "$today" ]]; then
  exit 0
fi

# label:cmds,…:apt_pkg:apt_install_name:other_hint
_deps=(
  'bat:bat,batcat:bat:bat:'
  'fd:fd,fdfind:fd-find:fd-find:'
  'eza:eza:eza:eza:'
  'git delta:delta:git-delta:git-delta:'
  'ripgrep:rg:ripgrep:ripgrep:'
  'zoxide:zoxide:zoxide:zoxide:cargo install zoxide'
  'fzf:fzf:fzf:fzf:git clone to ~/.fzf (auto on first zsh login) or: sudo apt install fzf'
  'jq:jq:jq:jq:'
  'chafa:chafa:chafa:chafa:'
  'PDF preview (pdftoppm):pdftoppm:poppler-utils:poppler-utils:'
  'PDF preview (mutool):mutool:mupdf-tools:mupdf-tools:'
  'video thumbnails:ffmpegthumbnailer:ffmpegthumbnailer:ffmpegthumbnailer:'
  'archives:atool:atool:atool:'
  'metadata (exiftool):exiftool:libimage-exiftool-perl:exiftool:'
  'metadata (mediainfo):mediainfo:mediainfo:mediainfo:'
  'disk usage:duf:duf:duf:'
  'process monitor:btop:btop:btop:'
  'ping graph:gping:gping:gping:snap install gping'
  'ping trace:mtr:mtr-tiny:mtr-tiny:'
  'GitHub CLI:gh:gh:gh:'
  'fnm:fnm:fnm:fnm:curl -fsSL https://fnm.vercel.app/install | bash'
  'better-commits:better-commits::better-commits:npm install -g better-commits'
)

_apt_candidate() {
  local pkg=$1 candidate
  candidate=$(apt-cache policy "$pkg" 2>/dev/null | awk '/Candidate:/ { print $2; exit }')
  [[ -n $candidate && $candidate != '(none)' ]]
}

_has_cmd() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" &>/dev/null && return 0
  done
  return 1
}

missing_labels=()
apt_install=()
other_hints=()

for entry in "${_deps[@]}"; do
  IFS=':' read -r label cmds apt_pkg apt_name other_hint <<< "$entry"
  IFS=',' read -ra bins <<< "$cmds"

  if [[ $label == 'fzf' ]]; then
    _has_cmd "${bins[@]}" || [[ -x ${HOME}/.fzf/bin/fzf ]] && continue
  elif [[ $label == 'fnm' ]]; then
    _has_cmd fnm && continue
    [[ -x ${HOME}/.local/share/fnm/fnm ]] && continue
  elif [[ $label == 'better-commits' ]]; then
    _has_cmd "${bins[@]}" && continue
    command -v fnm &>/dev/null && fnm exec -- command -v better-commits &>/dev/null && continue
  elif _has_cmd "${bins[@]}"; then
    continue
  fi

  missing_labels+=("$label")
  apt_name=${apt_name:-$apt_pkg}

  if [[ -n $apt_pkg ]] && _apt_candidate "$apt_pkg"; then
    apt_install+=("$apt_name")
  elif [[ -n $other_hint ]]; then
    other_hints+=("$label: $other_hint")
  elif [[ -n $apt_pkg ]]; then
    other_hints+=("$label: apt package '$apt_pkg' not in your repos")
  fi
done

echo "$today" > "$stamp"
(( ${#missing_labels[@]} )) || exit 0

# Comma-separated labels (labels may contain spaces).
missing_list=$(printf '%s, ' "${missing_labels[@]}")
missing_list=${missing_list%, }

fix_parts=()
if (( ${#apt_install[@]} )); then
  declare -A _seen=()
  apt_unique=()
  for pkg in "${apt_install[@]}"; do
    [[ -n ${_seen[$pkg]+x} ]] && continue
    _seen[$pkg]=1
    apt_unique+=("$pkg")
  done
  fix_parts+=("sudo apt install ${apt_unique[*]}")
fi
if (( ${#other_hints[@]} )); then
  fix_parts+=("$(IFS='; '; echo "${other_hints[*]}")")
fi

dotfiles_msg "optional tools not installed" "$missing_list"
if (( ${#fix_parts[@]} )); then
  fix_line=$(IFS='; '; echo "${fix_parts[*]}")
  dotfiles_msg fix "$fix_line"
fi
