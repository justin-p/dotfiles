
# Invoke-Item
alias ii='xdg-open'

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colorize plugin: use syntax-highlighted cat by default (disabled under Cursor agent shells)
cat() {
  if [[ -n ${CURSOR_AGENT:-} || -n ${CURSOR_TRACE:-} ]]; then
    command cat "$@"
    return
  fi

  if (( ${+aliases[ccat]} )); then
    ccat "$@"
  else
    command cat "$@"
  fi
}

# better-commits git wrapper (disabled under Cursor agent shells)
git() {
  if [[ -n ${CURSOR_AGENT:-} || -n ${CURSOR_TRACE:-} ]]; then
    command git "$@"
    return
  fi

  if command -v npm &>/dev/null; then
    if ! command -v better-commits &>/dev/null; then
      echo "better-commits is not installed. Installing now..."
      npm install -g better-commits
    fi
  fi

  if [[ "$1" == "commit" || "$1" == "add" ]]; then
    better-commits
  else
    command git "$@"
  fi
}

# zoxide: remap cd -> z (disabled under Cursor agent shells)
cd() {
  if [[ -n ${CURSOR_AGENT:-} || -n ${CURSOR_TRACE:-} ]]; then
    builtin cd "$@"
    return
  fi

  if (( ${+functions[z]} )); then
    z "$@"
  else
    builtin cd "$@"
  fi
}

# Prefer a modern CLI tool (bold/colored hint, same palette as zsh-you-should-use)
_prefer_tool_hint() {
  local preferred=$1
  if command -v tput &>/dev/null; then
    print -u2 "$(tput bold)$(tput setaf 3)Consider using $(tput setaf 5)$preferred$(tput setaf 3) instead.$(tput sgr0)"
  else
    print -u2 "Consider using $preferred instead."
  fi
}

# duf: warn when using df if duf is installed
if command -v duf &>/dev/null; then
  df() {
    if [[ -n ${CURSOR_AGENT:-} || -n ${CURSOR_TRACE:-} ]]; then
      command df "$@"
      return
    fi
    _prefer_tool_hint duf
    command df "$@"
  }
fi

# btop: warn when using htop if btop is installed
if command -v btop &>/dev/null; then
  htop() {
    if [[ -n ${CURSOR_AGENT:-} || -n ${CURSOR_TRACE:-} ]]; then
      command htop "$@"
      return
    fi
    _prefer_tool_hint btop
    command htop "$@"
  }
fi

# fd/fdfind: warn when using find if a fd binary is installed
if [[ -n ${_FD_CMD:-} ]]; then
  find() {
    if [[ -n ${CURSOR_AGENT:-} || -n ${CURSOR_TRACE:-} ]]; then
      command find "$@"
      return
    fi
    _prefer_tool_hint "$_FD_CMD"
    command find "$@"
  }
fi