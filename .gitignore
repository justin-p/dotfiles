BurpSuite/.BurpSuite/*
!BurpSuite/.BurpSuite/UserConfigPro.json
!BurpSuite/.BurpSuite/jython-standalone-2.7.2.jar

# SMB automount (local secrets; stow-compatible paths)
smb/.config/smb/*.env
smb/.config/smb/*.credentials
!smb/.config/smb/*.env.example
!smb/.config/smb/*.credentials.example

# Python bytecode
__pycache__/

# Antidote static bundle (generated in $HOME when .zsh_plugins changes)
.zsh_plugins.zsh