#!/usr/bin/env bash
set -euo pipefail

# Keep ~/.ssh on local disk (SSH requires strict permissions) and merge with
# ~/homesrv/.ssh on the NAS so keys/config follow you across machines.

LOCAL_SSH="${HOME}/.ssh"
REMOTE_SSH="${HOME}/homesrv/.ssh"
HOMESRV="${HOME}/homesrv"

RSYNC_EXCLUDES=(
  --exclude 'agent*'
  --exclude 'control-*'
  --exclude '*.sock'
)

ssh_sync_fix_local_perms() {
  chmod 700 "${LOCAL_SSH}"
  find "${LOCAL_SSH}" -type f -name 'id_*' ! -name '*.pub' -exec chmod 600 {} +
  find "${LOCAL_SSH}" -type f \( -name 'config' -o -name 'known_hosts' -o -name 'known_hosts.old' \) -exec chmod 600 {} +
  find "${LOCAL_SSH}" -type f -name '*.pub' -exec chmod 644 {} +
}

main() {
  local quiet=false
  [[ "${1:-}" == '--quiet' ]] && quiet=true

  if ! mountpoint -q "${HOMESRV}" 2>/dev/null; then
    "${quiet}" || echo "sync-ssh: ${HOMESRV} is not mounted; skipping." >&2
    exit 0
  fi

  mkdir -p "${LOCAL_SSH}" "${REMOTE_SSH}"

  # Newer file wins in each direction (merge, not mirror-delete).
  rsync -a --update "${RSYNC_EXCLUDES[@]}" "${LOCAL_SSH}/" "${REMOTE_SSH}/"
  rsync -a --update "${RSYNC_EXCLUDES[@]}" "${REMOTE_SSH}/" "${LOCAL_SSH}/"

  ssh_sync_fix_local_perms

  "${quiet}" || echo "sync-ssh: synced ${LOCAL_SSH} <-> ${REMOTE_SSH}"
}

main "$@"
