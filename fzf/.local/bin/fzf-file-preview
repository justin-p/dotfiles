#!/usr/bin/env bash
# fzf file preview — bat, chafa, archives, PDF/video thumbnails, git dirs.
# Based on https://github.com/junegunn/fzf/blob/master/bin/fzf-preview.sh
path=$1
[[ -n $path ]] || exit 0

file=${path/#\~\//$HOME/}
center=0
if [[ ! -e $file ]]; then
  if [[ $file =~ ^(.+):([0-9]+)\ *$ ]] && [[ -e ${BASH_REMATCH[1]} ]]; then
    file=${BASH_REMATCH[1]}
    center=${BASH_REMATCH[2]}
  elif [[ $file =~ ^(.+):([0-9]+):[0-9]+\ *$ ]] && [[ -e ${BASH_REMATCH[1]} ]]; then
    file=${BASH_REMATCH[1]}
    center=${BASH_REMATCH[2]}
  else
    exit 0
  fi
fi

_bat_cmd() {
  if command -v batcat &>/dev/null; then
    printf '%s' batcat
  elif command -v bat &>/dev/null; then
    printf '%s' bat
  fi
}

_bat_preview() {
  local target=$1
  local bat_cmd
  bat_cmd=$(_bat_cmd) || { cat "$target"; return; }
  if (( center > 0 )); then
    "$bat_cmd" --style="${BAT_STYLE:-numbers}" --color=always --pager=never \
      --highlight-line="$center" -- "$target"
  else
    "$bat_cmd" --style="${BAT_STYLE:-numbers}" --color=always --pager=never \
      --line-range=:500 -- "$target"
  fi
}

_preview_dims() {
  local dim=${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}
  if [[ $dim == x ]] && [[ -t 0 || -e /dev/tty ]]; then
    dim=$(stty size < /dev/tty 2>/dev/null | awk '{print $2 "x" $1}')
  fi
  if [[ -n $dim && $dim != x ]] && ! [[ $KITTY_WINDOW_ID ]] \
      && [[ -n ${FZF_PREVIEW_TOP:-}${FZF_PREVIEW_LINES:-} ]] \
      && (( FZF_PREVIEW_TOP + FZF_PREVIEW_LINES == $(stty size < /dev/tty 2>/dev/null | awk '{print $1}') )); then
    dim=${FZF_PREVIEW_COLUMNS}x$((FZF_PREVIEW_LINES - 1))
  fi
  printf '%s' "$dim"
}

_parent_is_cosmic_term() {
  local pid=$PPID comm
  while [[ -n $pid && $pid -gt 1 ]]; do
    [[ -r "/proc/$pid/comm" ]] || return 1
    comm=$(<"/proc/$pid/comm")
    [[ $comm == cosmic-term ]] && return 0
    pid=$(awk '/^PPid:/ { print $2; exit }' "/proc/$pid/status" 2>/dev/null) || return 1
  done
  return 1
}

_chafa_preview_image() {
  local img=$1 dim=$2
  local -a args=(-s "$dim" -c full)

  # --scale=max / --animate=off need chafa >= 1.12 (apt on Ubuntu 22.04 ships 1.8).
  if chafa --help 2>&1 | grep -q -- '--scale'; then
    args+=(--scale=max --animate=off)
  else
    args+=(--zoom -d 0)
  fi

  if [[ -n ${FZF_PREVIEW_IMAGE_FORMAT:-} ]]; then
    args+=(-f "$FZF_PREVIEW_IMAGE_FORMAT")
  elif _parent_is_cosmic_term \
      || [[ ${TERM_PROGRAM:-} == vscode || ${TERM_PROGRAM,,} == cursor ]]; then
    args+=(-f symbols --symbols=block+braille+half+quad --dither=ordered)
  elif [[ ${TERM_PROGRAM:-} == iTerm.app ]]; then
    args+=(-f iterm)
  fi

  if { [[ -n $KITTY_WINDOW_ID ]] || [[ -n $GHOSTTY_RESOURCES_DIR ]]; } \
      && command -v kitten &>/dev/null; then
    kitten icat --clear --transfer-mode=memory --unicode-placeholder --stdin=no \
      --place="${dim}@0x0" "$img" | sed '$d' | sed $'$s/$/\e[m/'
  elif command -v chafa &>/dev/null; then
    chafa "${args[@]}" "$img"
    echo
  elif command -v imgcat &>/dev/null; then
    imgcat -W "${dim%%x*}" -H "${dim##*x}" "$img"
  else
    file "$img"
  fi
}

_binary_metadata() {
  if command -v exiftool &>/dev/null; then
    exiftool "$file" 2>/dev/null | head -80
    return
  fi
  if command -v mediainfo &>/dev/null; then
    mediainfo "$file" 2>/dev/null
    return
  fi
  file "$file"
}

_directory_preview() {
  if [[ -d $file/.git ]]; then
    git -C "$file" log --oneline -5 2>/dev/null
    echo '---'
  fi
  if command -v eza &>/dev/null; then
    eza -T --level=2 --icons=auto "$file" 2>/dev/null
  else
    ls -la "$file"
  fi
}

_archive_preview() {
  if command -v atool &>/dev/null; then
    atool -l "$file" 2>/dev/null && return
  fi
  case ${type:-} in
    application/zip*) unzip -l "$file" 2>/dev/null && return ;;
  esac
  case $file in
    *.tar|*.tar.*|*.tgz|*.tbz2|*.txz)
      tar -tf "$file" 2>/dev/null | head -100
      return
      ;;
  esac
  file "$file"
}

_pdf_preview() {
  local dim=$1 tmp prefix rendered=
  tmp=$(mktemp "${TMPDIR:-/tmp}/fzf-preview.XXXXXX.png") || return 1
  prefix=${tmp%.png}
  if command -v pdftoppm &>/dev/null; then
    pdftoppm -png -f 1 -l 1 -singlefile "$file" "$prefix" 2>/dev/null \
      && [[ -f ${prefix}.png ]] && rendered=${prefix}.png
  fi
  if [[ -z $rendered ]] && command -v mutool &>/dev/null; then
    mutool draw -F png -o "$tmp" "$file" 1 2>/dev/null && [[ -f $tmp ]] && rendered=$tmp
  fi
  if [[ -n $rendered ]]; then
    _chafa_preview_image "$rendered" "$dim"
    rm -f "$tmp" "${prefix}.png"
    return
  fi
  rm -f "$tmp" "${prefix}.png"
  file "$file"
}

_video_preview() {
  local dim=$1 tmp thumb_w=0
  [[ $dim == *x* ]] && thumb_w=$(( ${dim%%x*} * 12 ))
  tmp=$(mktemp "${TMPDIR:-/tmp}/fzf-preview.XXXXXX.png") || return 1
  if command -v ffmpegthumbnailer &>/dev/null \
      && ffmpegthumbnailer -i "$file" -o "$tmp" -t 10 -s "${thumb_w:-800}" 2>/dev/null \
      && [[ -f $tmp ]]; then
    _chafa_preview_image "$tmp" "$dim"
    rm -f "$tmp"
    return
  fi
  rm -f "$tmp"
  _binary_metadata
}

if [[ -d $file ]]; then
  _directory_preview
  exit
fi

[[ -f $file ]] || exit 0

type=$(file --brief --dereference --mime -- "$file" 2>/dev/null) || exit 0

case $type in
  image/*)
    dim=$(_preview_dims)
    _chafa_preview_image "$file" "$dim"
    ;;
  video/*)
    dim=$(_preview_dims)
    _video_preview "$dim"
    ;;
  application/pdf)
    dim=$(_preview_dims)
    _pdf_preview "$dim"
    ;;
  application/zip*|application/x-7z*|application/x-rar*|application/gzip*|application/x-bzip2*|application/x-xz*|application/x-tar*|application/vnd.debian.binary-package*)
    _archive_preview
    ;;
  text/markdown*)
    _bat_preview "$file"
    ;;
  *)
    if [[ $file == *.md ]]; then
      _bat_preview "$file"
    elif [[ $type =~ =binary ]] || [[ $type == application/octet-stream* ]]; then
      _binary_metadata
    else
      _bat_preview "$file"
    fi
    ;;
esac
